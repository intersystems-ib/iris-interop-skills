/// Rule: BestPractices_Interop_IRIS.md §15.5 "Registering DICOM associations from OnStart — and the verify step that makes it worth doing"
/// Validity: Verified against IRIS for Health Community 2026.1 — compiled AND executed.
/// Severity: High (the failure mode is a green production whose every association is refused).
///
/// Pattern: the register-and-verify step, split out of the production's `OnStart` so it can be
/// tested without starting anything. The production beside this file is three lines of OnStart.
///
/// WHY A VERIFY STEP AT ALL. `CreateAssociation` is not the risky part; the state it leaves behind
/// is. An `EnsLib.DICOM.Util.AssociationContext` with an EMPTY `PresentationContexts` list
/// `%ValidateObject()`s clean, `%Save()`s clean, and makes `AETExists` return 1 — measured:
///
///     %New("ZZMOD3","ZZIRIS3")  newContexts=0  validate=OK  save=OK  AETExists=1
///
/// So the obvious `If 'AETExists(...) { CreateAssociation(...) }` guard is satisfied by a context
/// that offers the remote AE nothing. Every association is then refused at negotiation because the
/// two sides share no presentation context, there is no error at configuration time, and nothing
/// appears in the Event Log. Checking the COUNT is the only thing that tells the two apart.
///
/// THE TWO ARGUMENTS ARE (Calling, Called) — WIRE DIRECTION, and it is not IRIS-first. The
/// initiator is first and the responder second, so for an inbound C-STORE where IRIS is the SCP the
/// remote modality is the CALLING AE and IRIS is the CALLED one. An AE-title mismatch presents as an
/// association refused with no indication which side's title is wrong, which is why it is worth
/// getting from the one place that says it out loud. See §15.1: three different methods are named
/// `CreateAssociation`, with arities 2, 3 and 4, and only two of them take AE titles at all.
///
/// AND `AETExists` REALLY DOES TAKE TWO ARGUMENTS, whatever the class dictionary says. It is
/// generated by an index, so `%Dictionary.CompiledMethod` reports `FormalSpec = ''` and
/// `ClassMethod = False` for it and for seven siblings. Both are wrong — measured,
/// `AETExists("a","b")` returns 0 and `AETExists()` throws `<UNDEFINED>`. §15.2 has the rule.
///
/// MEASURED CONTEXT COUNTS, which is the number this class exists to check:
///
///     platform CreateAssociation(calling, called)            237 contexts
///     the vendored wrapper with pTypeList ("Storage","FIND")  209
///     the vendored wrapper with pTypeList ("Storage")         197
///     the vendored wrapper with pTypeList ("Storge") -- typo    0, and create= OK
///     a hand-built %New(...) + %Save()                          0, and save= OK
///
/// The dictionary here holds 289 abstract syntaxes, so the platform default offers nearly all of
/// them. That is exactly what the vendored sample's wrapper narrows and why it exists: some
/// simulators and older SCPs refuse an association request carrying 237 presentation contexts.
/// Narrowing is a legitimate choice; narrowing with a string that matches nothing is the defect,
/// and it is indistinguishable from the correct call by its return value.
Class Example.UTL.DicomAssociations Extends %RegisteredObject
{

/// Register one AE pair, then prove the context that landed is usable. `pCount` comes back with the
/// number of presentation contexts, so a caller can log the number rather than log "OK".
ClassMethod Register(pCallingAET As %String, pCalledAET As %String, Output pCount As %Integer) As %Status
{
    Set pCount = 0
    // NO BLANK-AET GUARD HERE, AND THAT IS DELIBERATE. The first version of this method had one. It
    // was removed when a mutation showed it made no difference: the platform already rejects a blank
    // title, and more usefully than a hand-rolled check could —
    //     CreateAssociation("", "X")  ->  <EnsDICOM>BadCallingAET: The Calling AET has an invalid value
    //     CreateAssociation("X", "")  ->  <EnsDICOM>BadCalledAET:  The Called AET has an invalid value
    // Each names WHICH side is wrong. A guard in front of that can only replace a specific error with
    // a vaguer one. Worth noticing which way round this cuts: the AE title's VALUE is validated, and
    // the presentation-context CONTENT is not — so of the two DICOM configuration mistakes, the one
    // that looks trivial fails loudly and the one that matters saves clean.

    // Two arguments -- see the header. The dictionary will tell you it takes none.
    If '##class(EnsLib.DICOM.Util.AssociationContext).AETExists(pCallingAET, pCalledAET) {
        Set tSC = ##class(EnsLib.DICOM.Util.AssociationContext).CreateAssociation(pCallingAET, pCalledAET)
        If $$$ISERR(tSC) { Quit tSC }
    }

    Set tSC = ..CountContexts(pCallingAET, pCalledAET, .pCount)
    If $$$ISERR(tSC) { Quit tSC }

    // THE REPAIR BRANCH, and the reason this is not just an assertion. An existing context with zero
    // presentation contexts makes the guard above skip creation for ever, so reporting the problem
    // is not enough -- nothing else in the system will ever fix it. Delete and rebuild.
    If pCount = 0 {
        Set tSC = ##class(EnsLib.DICOM.Util.AssociationContext).AETDelete(pCallingAET, pCalledAET)
        If $$$ISERR(tSC) { Quit tSC }
        Set tSC = ##class(EnsLib.DICOM.Util.AssociationContext).CreateAssociation(pCallingAET, pCalledAET)
        If $$$ISERR(tSC) { Quit tSC }
        Set tSC = ..CountContexts(pCallingAET, pCalledAET, .pCount)
        If $$$ISERR(tSC) { Quit tSC }
    }

    // DEFENSIVE AND UNFALSIFIED, said at the branch rather than left looking covered. Reaching this
    // needs a REBUILD that also yields zero contexts, which on this build would mean an empty
    // ^EnsDICOM.Dictionary("as","u") — 289 entries today, and not something a test can arrange without
    // breaking the namespace for everything else. The mutation that makes this branch return $$$OK
    // leaves the suite green; that is a real gap in coverage, not a non-mutation, and it is here
    // because a rebuild that silently yields nothing is precisely the case that must not pass.
    If pCount = 0 {
        Set tWhy = "association " _ pCallingAET _ " -> " _ pCalledAET _ " has ZERO presentation contexts after a rebuild; every association will be refused at negotiation"
        Quit $$$ERROR($$$GeneralError, tWhy)
    }
    Quit $$$OK
}

/// The count, by itself, so a test can ask the question without changing anything.
ClassMethod CountContexts(pCallingAET As %String, pCalledAET As %String, Output pCount As %Integer) As %Status
{
    Set pCount = 0
    Set tCtx = ##class(EnsLib.DICOM.Util.AssociationContext).AETOpen(pCallingAET, pCalledAET, , .tSC)
    If '$IsObject(tCtx) {
        Set tWhy = "association context " _ pCallingAET _ " -> " _ pCalledAET _ " did not open: " _ $System.Status.GetErrorText(tSC)
        Quit $$$ERROR($$$GeneralError, tWhy)
    }
    Set pCount = tCtx.PresentationContexts.Count()
    Quit $$$OK
}

}
