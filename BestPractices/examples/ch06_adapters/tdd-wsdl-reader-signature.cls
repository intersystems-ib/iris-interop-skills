/// Rule: BestPractices_Interop_IRIS.md §6.20 "`%SOAP.WSDL.Reader.Process`: the measured signature, and why a typed `#Dim` is not a gate"
/// Validity: Verified against IRIS for Health Community 2026.1 — and RUN.
/// Severity: Medium (six ways to get the call wrong, zero caught by the compiler).
///
/// Pattern: the oracle for `soap-wsdl-reader-generate.cls`, and the thing that actually holds
/// `soap-bo`'s "Verified on IRIS-for-Health 2026.1" signature claim in place.
///
/// WHY THIS SUITE EXISTS AT ALL. The coverage map proposed pinning the arity behind a typed `#Dim` so a
/// version change would be caught at compile time. Measured, that does not work: a typed `#Dim` gates
/// neither arity nor even method existence, because ObjectScript resolves instance-method calls at run
/// time. `TestWrongArityOnATypedDimStillCompiles` asserts that directly -- it is the only assertion here
/// whose expected result is "no error", so it carries a control proving the compiler really ran.
///
/// NO NETWORK. `pLocationURL` accepts a local file path, so the WSDL lives in an XData block below,
/// gets written to a temp file, and is read back from there. Nothing has to be reachable.
///
/// RUN AND MUTATION-CHECKED, measured:
///
///     as shipped                                  run=371  4 methods, 0 failed
///     FromLocation drops the package argument     run=372  2 failed
///     MakeBusinessOperation never set             run=373  1 failed -- the differential test
///     FromLocation returns OK without calling     run=374  2 failed
///     reverted                                    run=375  4 methods, 0 failed
///
/// Mutation 2 survived the FIRST version of this suite. Nothing asserted what the flag did, so silently
/// dropping it was invisible -- exactly the defect the flag exists to prevent. The differential test was
/// added because of that, not before it.
///
/// HOW TO RUN IT -- one compiled class per call, `pattern` does not expand a package:
///     iris_test(pattern="Example.Tests.WsdlReaderSignature", namespace="<NS>")
Class Example.Tests.WsdlReaderSignature Extends %UnitTest.TestCase
{

/// Package the generation writes into. Deleted in %OnAfterAllTests.
Parameter GENPKG As STRING = "ExampleWsdlGen";

Parameter WSDLPATH As STRING = "/tmp/example-wsdl-reader-oracle.wsdl";

/// Throwaway class compiled by TestWrongArityOnATypedDimStillCompiles.
Parameter PROBE As STRING = "ExampleWsdlGen.ArityProbe";

/// A one-operation WSDL, generated by IRIS from a `%SOAP.WebService` and then made vendor-neutral, so
/// the Reader is known to accept it. Kept HERE rather than in a .wsdl file: the bank's index gate pairs
/// every file with a README row, and this is data belonging to one test.
XData CalcWsdl
{
<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:s0="http://example.org/demo/calc" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.org/demo/calc">
    <types>
        <s:schema elementFormDefault="qualified" targetNamespace="http://example.org/demo/calc">
            <s:element name="Add">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="a" type="s:long"/>
                        <s:element minOccurs="0" name="b" type="s:long"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:element name="AddResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="AddResult" type="s:long"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
        </s:schema>
    </types>
    <message name="AddSoapIn">
        <part name="parameters" element="s0:Add"/>
    </message>
    <message name="AddSoapOut">
        <part name="parameters" element="s0:AddResponse"/>
    </message>
    <portType name="DemoCalcSoap">
        <operation name="Add">
            <input message="s0:AddSoapIn"/>
            <output message="s0:AddSoapOut"/>
        </operation>
    </portType>
    <binding name="DemoCalcSoap" type="s0:DemoCalcSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="Add">
            <soap:operation soapAction="http://example.org/demo/calc/Demo.WS.CalcService.Add" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>
    <service name="DemoCalc">
        <port name="DemoCalcSoap" binding="s0:DemoCalcSoap">
            <soap:address location="https://example.org/demo/calc"/>
        </port>
    </service>
</definitions>
}

/// `OnAfterAllTests`, NOT `%OnAfterAllTests`. The `%`-prefixed spelling shipped in v1.76.0 and was DEAD
/// CODE: `%UnitTest.TestCase` declares the unprefixed names, so this teardown never ran. Nothing leaked,
/// because the tests themselves call DropGenerated(), but the temp WSDL file survived every run and the
/// method advertised a cleanup it did not perform. Found by grepping for the spelling after the same
/// mistake broke §1.21's suite.
Method OnAfterAllTests() As %Status
{
    Do ..DropGenerated()
    Do ##class(%File).Delete(..#WSDLPATH)
    Quit $$$OK
}

ClassMethod DropGenerated() As %Integer [ Private ]
{
    Set tCount = 0
    Set tRs = ##class(%SQL.Statement).%ExecDirect(,
        "SELECT Name FROM %Dictionary.CompiledClass WHERE Name %STARTSWITH ?", ..#GENPKG)
    Quit:tRs.%SQLCODE<0 0
    While tRs.%Next() { Set tNames(tRs.%Get("Name")) = "" }
    Set tName = ""
    For {
        Set tName = $Order(tNames(tName))
        Quit:tName=""
        Do $System.OBJ.Delete(tName, "-d")
        Set tCount = tCount + 1
    }
    Quit tCount
}

/// Write the XData WSDL out to a file. Returns the byte count, so a caller can prove it landed.
ClassMethod WriteWsdl() As %Integer [ Private ]
{
    Set tXData = ##class(%Dictionary.CompiledXData).%OpenId($ClassName() _ "||CalcWsdl", 0)
    Quit:'$IsObject(tXData) 0
    Do ##class(%File).Delete(..#WSDLPATH)
    Set tFile = ##class(%Stream.FileCharacter).%New()
    Quit:$$$ISERR(tFile.LinkToFile(..#WSDLPATH)) 0
    Do tXData.Data.Rewind()
    While 'tXData.Data.AtEnd { Do tFile.Write(tXData.Data.Read(8000)) }
    Quit:$$$ISERR(tFile.%Save()) 0
    Quit ##class(%File).GetFileSize(..#WSDLPATH)
}

/// The signature, straight from the dictionary. This is the standing gate the `#Dim` could not be.
Method TestSignatureIsExactlyFourParameters() As %Status
{
    Set tDef = ##class(%Dictionary.CompiledMethod).%OpenId("%SOAP.WSDL.Reader||Process", 0)
    Do $$$AssertTrue($IsObject(tDef), "POSITIVE CONTROL: %SOAP.WSDL.Reader::Process is in the dictionary -- without this row every assertion below would be vacuous")
    Do $$$AssertEquals(tDef.ClassMethod, 0, "Process is an INSTANCE method, so it must be reached through %New()")
    Do $$$AssertEquals(tDef.ReturnType, "%Library.Status", "and it returns a %Status")
    // The formal spec verbatim. A new parameter, a renamed one or a changed default all break this.
    // Built into a variable first: a macro invocation MUST be on one line (MPP5612), and the expected
    // string is too long to share a line with the assertion.
    Set tExpected = "pLocationURL:%String,pPackage:%String="""",pTest:%Boolean=0,"
    Set tExpected = tExpected _ "schemaReader:%XML.Utils.SchemaReader="""""
    Do $$$AssertEquals(tDef.FormalSpec, tExpected, "the formal spec is unchanged, got: " _ tDef.FormalSpec)
    Quit $$$OK
}

/// The generation actually runs, from a local file, and produces operations + 1 classes.
Method TestProcessGeneratesFromALocalFilePath() As %Status
{
    Set tBytes = ..WriteWsdl()
    Do $$$AssertTrue(tBytes > 500, "POSITIVE CONTROL: the XData WSDL was written to disk (" _ tBytes _ " bytes) -- a generation failure below is otherwise unattributable")
    Do ..DropGenerated()
    Set tSC = ##class(Example.UTL.WsdlGenerate).FromLocation(..#WSDLPATH, ..#GENPKG)
    Do $$$AssertStatusOK(tSC, "Process() accepts a local FILE PATH as pLocationURL, not only a URL")
    Set tRs = ##class(%SQL.Statement).%ExecDirect(,
        "SELECT COUNT(*) AS n FROM %Dictionary.CompiledClass WHERE Name %STARTSWITH ?", ..#GENPKG)
    Do $$$AssertTrue(tRs.%SQLCODE >= 0, "the generated-class query ran: SQLCODE " _ tRs.%SQLCODE)
    Do tRs.%Next()
    // One operation in the WSDL, so: the client class plus one class for the operation.
    Do $$$AssertTrue(tRs.%Get("n") >= 2, "a one-operation WSDL yields the client class PLUS one class per web method, found " _ tRs.%Get("n"))
    Quit $$$OK
}

/// What `MakeBusinessOperation` actually buys, as a differential. Measured on this one-operation WSDL:
///
///     flag = 0   <Pkg>.DemoCalcSoap        %SOAP.WebClient
///                <Pkg>.DemoCalcSoap.Add    %SOAP.ProxyDescriptor
///     flag = 1   the two above, PLUS
///                <Pkg>.BusOp.DemoCalcSoap  Ens.BusinessOperation
///                <Pkg>.BusOp.AddRequest    Ens.Request
///                <Pkg>.BusOp.AddResponse   Ens.Response
///
/// Note the **`BusOp` sub-package**: the interop classes do not land beside the client, they land one
/// level down. Asserted as a difference between two runs, because "3 classes appeared" would also be
/// true if the flag were ignored and the WSDL simply had more operations.
Method TestMakeBusinessOperationAddsTheInteropTrio() As %Status
{
    Set tBytes = ..WriteWsdl()
    Do $$$AssertTrue(tBytes > 500, "POSITIVE CONTROL: the WSDL was written (" _ tBytes _ " bytes)")
    Do ..DropGenerated()
    Set tWith = ##class(Example.UTL.WsdlGenerate).FromLocation(..#WSDLPATH, ..#GENPKG _ "Bo", 1)
    Do $$$AssertStatusOK(tWith, "generation with MakeBusinessOperation = 1 succeeds")
    Set tWithout = ##class(Example.UTL.WsdlGenerate).FromLocation(..#WSDLPATH, ..#GENPKG _ "Plain", 0)
    Do $$$AssertStatusOK(tWithout, "generation with MakeBusinessOperation = 0 succeeds")
    Set tNBo = ..CountIn(..#GENPKG _ "Bo")
    Set tNPlain = ..CountIn(..#GENPKG _ "Plain")
    // POSITIVE CONTROL: the flag = 0 run must produce something, or a difference means nothing.
    Do $$$AssertTrue(tNPlain >= 2, "POSITIVE CONTROL: the plain run generated the client and its proxy, found " _ tNPlain)
    Do $$$AssertEquals(tNBo - tNPlain, 3, "MakeBusinessOperation = 1 adds exactly three classes, got " _ tNBo _ " vs " _ tNPlain)
    // And they are the interop trio, in a BusOp sub-package -- the part the skills do not state.
    Do $$$AssertEquals(..SuperOf(..#GENPKG _ "Bo.BusOp.DemoCalcSoap"), "Ens.BusinessOperation", "the generated Business Operation sits under .BusOp and extends Ens.BusinessOperation")
    Do $$$AssertEquals(..SuperOf(..#GENPKG _ "Bo.BusOp.AddRequest"), "Ens.Request", "with an Ens.Request per operation")
    Do $$$AssertEquals(..SuperOf(..#GENPKG _ "Bo.BusOp.AddResponse"), "Ens.Response", "and an Ens.Response per operation")
    // The flag = 0 run has none of them -- this is what the difference above is made of.
    Do $$$AssertEquals(..SuperOf(..#GENPKG _ "Plain.BusOp.DemoCalcSoap"), "<absent>", "and with the flag off, no Business Operation is generated at all")
    // The client itself is the same in both runs.
    Do $$$AssertEquals(..SuperOf(..#GENPKG _ "Plain.DemoCalcSoap"), "%SOAP.WebClient", "the client class extends %SOAP.WebClient either way")
    Do ..DropGenerated()
    Quit $$$OK
}

ClassMethod CountIn(pPackage As %String) As %Integer [ Private ]
{
    Set tRs = ##class(%SQL.Statement).%ExecDirect(,
        "SELECT COUNT(*) AS n FROM %Dictionary.CompiledClass WHERE Name %STARTSWITH ?", pPackage _ ".")
    Quit:tRs.%SQLCODE<0 -1
    Do tRs.%Next()
    Quit tRs.%Get("n")
}

/// The Super of a compiled class, or "<absent>". Returning a sentinel rather than "" keeps an absent
/// class distinguishable from one whose Super really is empty.
ClassMethod SuperOf(pClass As %String) As %String [ Private ]
{
    Set tDef = ##class(%Dictionary.CompiledClass).%OpenId(pClass, 0)
    Quit $Select($IsObject(tDef):tDef.Super, 1:"<absent>")
}

/// THE NEGATIVE FINDING, asserted. A typed `#Dim` gates neither arity nor existence -- so this class,
/// which calls Process with five arguments and also calls a method that does not exist, compiles clean.
/// Expected result "no error" is exactly the shape that passes when nothing ran, hence the control.
Method TestWrongArityOnATypedDimStillCompiles() As %Status
{
    Set tBody = "Set tSC = tR.Process(""x"", ""y"", 0, """", ""extra"")" _ $Char(13,10) _ "    Do tR.NoSuchMethodAtAll()"
    Set tBad = ..CompileProbe(tBody)
    Do $$$AssertStatusOK(tBad, "a typed #Dim does NOT gate arity or method existence -- this compiles, which is the whole point of §6.20")
    // POSITIVE CONTROL: the same harness must REJECT genuinely broken ObjectScript, or "compiles clean"
    // above only means the compiler was never invoked.
    Set tGood = ..CompileProbe("Set tSC = ((( ")
    Do $$$AssertNotTrue($$$ISOK(tGood), "POSITIVE CONTROL: the same probe harness DOES reject a syntax error, so the pass above is a real compile")
    Do ..DropGenerated()
    Quit $$$OK
}

/// Compile a throwaway class whose body is pBody, with a typed #Dim in scope. Returns the compile status.
ClassMethod CompileProbe(pBody As %String) As %Status [ Private ]
{
    Do $System.OBJ.Delete(..#PROBE, "-d")
    Set tClass = ##class(%Dictionary.ClassDefinition).%New(..#PROBE)
    Set tClass.Super = "%RegisteredObject"
    Set tMethod = ##class(%Dictionary.MethodDefinition).%New()
    Set tMethod.Name = "Go"
    Set tMethod.ReturnType = "%Status"
    Do tMethod.Implementation.WriteLine("    #Dim tR As %SOAP.WSDL.Reader = ##class(%SOAP.WSDL.Reader).%New()")
    Do tMethod.Implementation.WriteLine("    " _ pBody)
    Do tMethod.Implementation.WriteLine("    Quit $$$OK")
    Do tClass.Methods.Insert(tMethod)
    Set tSC = tClass.%Save()
    Quit:$$$ISERR(tSC) tSC
    // -d keeps the console quiet; the returned status is the verdict.
    Quit $System.OBJ.Compile(..#PROBE, "-d")
}

}
